STANFORD_AI_OS_APP_NAME=Stanford-AI OS
STANFORD_AI_OS_ENVIRONMENT=development
STANFORD_AI_OS_DATABASE_URL=sqlite:///./stanford_ai_os.db

STANFORD_AI_OS_MODEL_PROVIDER=ollama
STANFORD_AI_OS_OLLAMA_BASE_URL=http://localhost:11434
STANFORD_AI_OS_OLLAMA_MODEL=qwen3:4b

# NVIDIA provider (optional). Never commit a real key.
# STANFORD_AI_OS_MODEL_PROVIDER=nvidia
# STANFORD_AI_OS_NVIDIA_API_KEY=your-nvidia-api-key
# STANFORD_AI_OS_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# STANFORD_AI_OS_NVIDIA_MODEL=meta/llama-3.3-70b-instruct

STANFORD_AI_OS_MODEL_TIMEOUT_SECONDS=60
