STANFORD_AI_OS_APP_NAME=Stanford-AI OS
STANFORD_AI_OS_ENVIRONMENT=development
STANFORD_AI_OS_DATABASE_URL=sqlite:///./stanford_ai_os.db

# Optional: use an absolute path on a Render persistent disk.
# STANFORD_AI_OS_DATABASE_URL=sqlite:////var/data/stanford_ai_os.db

STANFORD_AI_OS_MODEL_PROVIDER=ollama
STANFORD_AI_OS_OLLAMA_BASE_URL=http://localhost:11434
STANFORD_AI_OS_OLLAMA_MODEL=qwen3:4b

# NVIDIA provider (optional). Never commit a real key.
# STANFORD_AI_OS_MODEL_PROVIDER=nvidia
# STANFORD_AI_OS_NVIDIA_API_KEY=your-nvidia-api-key
# STANFORD_AI_OS_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# STANFORD_AI_OS_NVIDIA_MODEL=meta/llama-3.3-70b-instruct

STANFORD_AI_OS_MODEL_TIMEOUT_SECONDS=60

# Authentication (required for protected endpoints)
STANFORD_AI_OS_SECRET_KEY=replace-with-a-strong-secret-at-least-32-characters
STANFORD_AI_OS_ADMIN_USERNAME=admin
STANFORD_AI_OS_ADMIN_PASSWORD=replace-with-a-strong-password
STANFORD_AI_OS_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate limiting
STANFORD_AI_OS_LOGIN_RATE_LIMIT_ATTEMPTS=5
STANFORD_AI_OS_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
STANFORD_AI_OS_EXECUTION_RATE_LIMIT_ATTEMPTS=10
STANFORD_AI_OS_EXECUTION_RATE_LIMIT_WINDOW_SECONDS=60

# Logging
STANFORD_AI_OS_LOG_LEVEL=INFO

# CORS (comma-separated explicit origins; leave empty to disable)
STANFORD_AI_OS_CORS_ALLOWED_ORIGINS=
